# Public application configuration. Copy to .dev.vars for local Worker development.
APP_ENV=local
APP_ORIGIN=http://localhost:8787
WORKOS_CLIENT_ID=client_replace_me
WORKOS_REDIRECT_URI=http://localhost:8787/auth/callback
GITHUB_APP_ID=0
GITHUB_APP_SLUG=snappydiff-local

# Secrets are intentionally unnamed here by value. Set them with `wrangler secret put`.
# Required secret names:
# WORKOS_API_KEY
# WORKOS_WEBHOOK_SECRET
# WORKOS_COOKIE_PASSWORD (at least 32 random bytes)
# GITHUB_APP_PRIVATE_KEY
# GITHUB_WEBHOOK_SECRET
# TOKEN_PEPPER (at least 32 random bytes)
