{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snappydiff-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/webhooks/*", "/health"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snappydiff-local",
      "database_id": "replace-with-environment-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "snappydiff-local-images"
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://localhost:8787",
    "WORKOS_CLIENT_ID": "client_replace_me",
    "WORKOS_REDIRECT_URI": "http://localhost:8787/auth/callback",
    "GITHUB_APP_ID": "0",
    "GITHUB_APP_SLUG": "snappydiff-local"
  }
}
