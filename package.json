{
  "name": "snappydiff",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate:config": "node scripts/validate-config.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}

